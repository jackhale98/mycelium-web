// The git sync worker. JSONC (not TOML) on purpose: Wrangler prefers a
// .jsonc config, and would otherwise pick up the site's wrangler.jsonc at the
// repository root when deploying from this folder.
{
	"name": "mycelium-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Keep variables set in the Cloudflare dashboard when deploying (secrets are always
	// kept); otherwise every build would delete them.
	"keep_vars": true,
	// No logs, and no storage except opt-in reminders: one small Durable Object
	// per browser push subscription (see src/push.ts). No KV, D1 or R2.
	"observability": { "enabled": false },
	"durable_objects": {
		"bindings": [{ "name": "REMINDERS", "class_name": "ReminderQueue" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderQueue"] }],
	"vars": {
		// Origins that may use this worker: the site (my-celium.org, its workers.dev
		// address and the GitHub Pages copy) and localhost for development.
		"ALLOWED_ORIGINS": "https://my-celium.org,https://www.my-celium.org,https://my-celium.fonur.workers.dev,https://jackhale98.github.io,http://localhost:4321",
		// "EXTRA_GIT_HOSTS": "git.example.com",
	},
	// OAuth client credentials are secrets, never vars:
	//   npx wrangler secret put GITHUB_CLIENT_ID
	//   npx wrangler secret put GITHUB_CLIENT_SECRET
	// (and GITLAB_*, BITBUCKET_* when those apps are registered)
	// Reminders (Web Push): `node scripts/vapid-keys.mjs` prints a key pair, then
	//   npx wrangler secret put VAPID_PUBLIC_KEY
	//   npx wrangler secret put VAPID_PRIVATE_KEY
	// and optionally the var VAPID_SUBJECT (mailto: or https contact).
}
