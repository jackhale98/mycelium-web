---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const appUrl = `${base}/app`;
const repo = 'https://github.com/jackhale98/mycelium-web';

const features = [
	{
		title: 'Byte-exact edits',
		body: 'Changes are applied as tiny text patches to your original files. Spacing, line endings and syntax we don’t understand stay exactly as Emacs left them.',
		icon: '<path d="M4 6h16M4 12h10M4 18h7"/><path d="m15 17 2 2 4-4"/>',
	},
	{
		title: 'Backlinks & graph',
		body: 'Every id: link, alias and ROAM_REF is indexed locally, so backlinks with context, unlinked mentions and the node graph are instant.',
		icon: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8.3 7.2 15.6 7M7.2 8.2l3.7 7.6M16.9 9.2l-3.7 6.6"/>',
	},
	{
		title: 'Capture & dailies',
		body: 'Jot a thought into today’s daily note in two seconds, follow org-roam’s file naming, and create linked nodes as you type.',
		icon: '<path d="M20 4c-6 0-12 4-12 11v5"/><path d="M8 15h6c3 0 6-3 6-11"/><path d="M4 20 8 16"/>',
	},
	{
		title: 'Agenda that respects org',
		body: 'TODO keywords per file, SCHEDULED and DEADLINE, CLOSED stamps and all three repeater styles behave the way org-mode does.',
		icon: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="m3.5 6 1.5 1.5L7.5 5M3.5 12l1.5 1.5L7.5 11"/><circle cx="5" cy="18" r="1.2"/>',
	},
	{
		title: 'Your git, your rules',
		body: 'Sign in with GitHub, GitLab or Bitbucket and pick a repository. Notes are cloned into your browser; you choose when to sync.',
		icon: '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="9" r="2.5"/><path d="M6 8.5v7M18 11.5c0 3-3 4-7.5 4.5"/>',
	},
	{
		title: 'Private by design',
		body: 'No accounts, no database of yours on our side. Tokens stay on your device and the sync proxy is stateless and self-hostable.',
		icon: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
	},
];
---

<Base title="Mycelium · org-roam, anywhere" bodyClass="landing">
	<a class="skip-link" href="#content">
		Skip to content
	</a>
	<header class="top">
		<a class="brand" href={`${base}/`} aria-label="Mycelium home">
			<img class="mark" src={`${base}/mycelium-icon.svg`} width="34" height="34" alt="" />
			<span>Mycelium</span>
		</a>
		<nav aria-label="Site">
			<a href="#features">Features</a>
			<a href="#how">How it works</a>
			<a href={repo} rel="noopener">
				GitHub
			</a>
			<a class="btn small" href={appUrl}>
				Open app
			</a>
		</nav>
	</header>

	<main id="content">
		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">Open source · for org-roam</p>
				<h1>
					Your second brain, <em>wherever you are.</em>
				</h1>
				<p class="lede">
					Mycelium is a fast, beautiful web app for reading, linking and capturing your org-roam
					notes straight from your git repository — on your phone, tablet or any computer. No Emacs
					required, and nothing about your files changes that you didn’t change.
				</p>
				<div class="ctas">
					<a class="btn" href={appUrl}>
						Explore the demo vault <span aria-hidden="true">→</span>
					</a>
					<a class="btn ghost" href="#how">
						How sync works
					</a>
				</div>
				<p class="fine">Works with GitHub, GitLab and Bitbucket · Installable on iOS and Android</p>
			</div>

			<div class="preview" aria-hidden="true">
				<div class="window">
					<div class="win-bar">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="win-body">
						<div class="win-side">
							<div class="ws-brand"></div>
							<div class="ws-search">
								Search <kbd>⌘K</kbd>
							</div>
							<div class="ws-item on">Mycelial networks</div>
							<div class="ws-item">Zettelkasten</div>
							<div class="ws-item">Evergreen notes</div>
							<div class="ws-item">The wood wide web</div>
							<div class="ws-item">Reading list</div>
						</div>
						<div class="win-main">
							<p class="wm-crumb">20261001093000-mycelial_networks.org</p>
							<p class="wm-title">Mycelial networks</p>
							<p class="wm-tags">
								<span>#biology</span>
								<span>#networks</span>
							</p>
							<p class="wm-text">
								Mycelium is the branching, thread-like body of a fungus. A single network can span
								hectares and live for centuries.
							</p>
							<p class="wm-h">Why it matters</p>
							<p class="wm-text">
								The original <u>distributed system</u>: no centre, every junction can route
								resources — the idea behind <u>Zettelkasten</u>.
							</p>
						</div>
						<div class="win-panel">
							<p class="wp-h">
								Backlinks <span>4</span>
							</p>
							<div class="wp-card">
								<b>The wood wide web</b>
								<span>
									Builds on <u>Mycelial networks</u> and forest ecology.
								</span>
							</div>
							<div class="wp-card">
								<b>2026-10-18</b>
								<span>
									Reminded me of <u>Mycelial networks</u>…
								</span>
							</div>
							<div class="wp-card">
								<b>Evergreen notes</b>
								<span>
									Like a <u>fungal network</u>, the payoff…
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="features" class="features" aria-labelledby="features-h">
			<h2 id="features-h">Everything org-roam is good at, in your pocket.</h2>
			<ul>
				{features.map((f) => (
					<li>
						<svg
							class="f-icon"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							aria-hidden="true"
							set:html={f.icon}
						/>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</li>
				))}
			</ul>
		</section>

		<section id="how" class="how" aria-labelledby="how-h">
			<h2 id="how-h">How it works</h2>
			<ol>
				<li>
					<span class="n">1</span>
					<h3>Sign in with your git host</h3>
					<p>
						Authorise Mycelium on GitHub, GitLab or Bitbucket and choose exactly which repositories
						it may read and write.
					</p>
				</li>
				<li>
					<span class="n">2</span>
					<h3>Your vault is cloned locally</h3>
					<p>
						The repository is cloned into your browser’s private storage and indexed: nodes, links,
						tags and tasks. It keeps working offline.
					</p>
				</li>
				<li>
					<span class="n">3</span>
					<h3>Edit, then sync when ready</h3>
					<p>
						Every save is a local commit. Press Sync to pull, merge and push. Conflicts are shown
						side by side, never silently overwritten.
					</p>
				</li>
			</ol>
		</section>
	</main>

	<footer class="foot">
		<p>
			Mycelium is open source under the Apache 2.0 licence. Not affiliated with org-roam or the GNU
			Emacs project.
		</p>
		<p>
			<a href={repo} rel="noopener">
				Source on GitHub
			</a>
		</p>
	</footer>
</Base>

<style>
	:global(body.landing) {
		background:
			radial-gradient(
				60rem 30rem at 85% -10%,
				color-mix(in oklab, var(--accent) 12%, transparent),
				transparent 70%
			),
			radial-gradient(
				40rem 24rem at -10% 10%,
				color-mix(in oklab, var(--todo) 7%, transparent),
				transparent 70%
			),
			var(--bg);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 76rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-read);
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		text-decoration: none;
	}
	.mark {
		border-radius: 22%;
	}
	.top nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-size: 0.9rem;
		font-weight: 500;
	}
	.top nav a:not(.btn) {
		color: var(--text-muted);
		text-decoration: none;
	}
	.top nav a:not(.btn):hover {
		color: var(--text);
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.9rem;
		padding: 0 1.3rem;
		border-radius: 12px;
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
		text-decoration: none;
		box-shadow:
			var(--shadow-md),
			inset 0 1px 0 rgb(255 255 255 / 0.15);
		transition:
			transform 0.15s var(--ease),
			background-color 0.15s var(--ease);
	}
	.btn:hover {
		background: var(--accent-strong);
		transform: translateY(-1px);
	}
	.btn.small {
		height: 2.25rem;
		padding: 0 0.95rem;
		border-radius: 10px;
		font-size: 0.85rem;
	}
	.btn.ghost {
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text);
		box-shadow: var(--shadow-sm);
	}
	.btn.ghost:hover {
		background: var(--surface-2);
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
		align-items: center;
		gap: 3.5rem;
		max-width: 76rem;
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font-family: var(--font-read);
		font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.1rem);
		font-weight: 560;
		line-height: 1.04;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	h1 em {
		color: var(--accent);
		font-style: italic;
		font-weight: 500;
	}
	.lede {
		max-width: 34rem;
		margin: 1.4rem 0 0;
		color: var(--text-2);
		font-size: 1.08rem;
		line-height: 1.65;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.fine {
		margin: 1.1rem 0 0;
		color: var(--text-faint);
		font-size: 0.82rem;
	}

	/* ---- product preview */
	.preview {
		perspective: 1600px;
	}
	.window {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--surface);
		box-shadow: var(--shadow-lg);
		overflow: hidden;
		transform: rotateY(-6deg) rotateX(2deg);
		transform-origin: left center;
	}
	.win-bar {
		display: flex;
		gap: 6px;
		padding: 0.7rem 0.9rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface-2);
	}
	.win-bar span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--border-strong);
	}
	.win-body {
		display: grid;
		grid-template-columns: 9.5rem 1fr 11rem;
		min-height: 22rem;
		font-size: 0.72rem;
	}
	.win-side {
		padding: 0.8rem 0.6rem;
		border-right: 1px solid var(--border);
		background: var(--bg-raised);
	}
	.ws-brand {
		width: 5rem;
		height: 0.8rem;
		margin: 0.1rem 0.3rem 0.8rem;
		border-radius: 4px;
		background: var(--surface-3);
	}
	.ws-search {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.6rem;
		padding: 0.35rem 0.45rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text-faint);
	}
	.ws-search kbd {
		font-size: 0.55rem;
	}
	.ws-item {
		padding: 0.3rem 0.45rem;
		border-radius: 5px;
		color: var(--text-muted);
	}
	.ws-item.on {
		background: var(--accent-soft);
		color: var(--accent-strong);
		font-weight: 600;
	}
	.win-main {
		padding: 1.2rem 1.3rem;
	}
	.win-main p {
		margin: 0;
	}
	.wm-crumb {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 0.58rem;
	}
	.wm-title {
		margin-top: 0.35rem !important;
		font-family: var(--font-read);
		font-size: 1.45rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.wm-tags {
		display: flex;
		gap: 0.3rem;
		margin: 0.5rem 0 0.7rem !important;
	}
	.wm-tags span {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--accent-softer);
		color: var(--accent-strong);
		font-size: 0.6rem;
		font-weight: 600;
	}
	.wm-text {
		color: var(--text-2);
		font-family: var(--font-read);
		font-size: 0.82rem;
		line-height: 1.55;
	}
	.wm-text u,
	.wp-card u {
		color: var(--link);
		text-decoration-color: var(--link-underline);
	}
	.wm-h {
		margin: 0.8rem 0 0.25rem !important;
		font-family: var(--font-read);
		font-size: 1rem;
		font-weight: 600;
	}
	.win-panel {
		padding: 1.2rem 0.8rem;
		border-left: 1px solid var(--border);
		background: var(--bg-raised);
	}
	.wp-h {
		display: flex;
		justify-content: space-between;
		margin: 0 0 0.6rem;
		color: var(--text-muted);
		font-size: 0.58rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.wp-card {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		margin-bottom: 0.45rem;
		padding: 0.5rem 0.55rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: var(--text-muted);
		font-size: 0.62rem;
		line-height: 1.4;
	}
	.wp-card b {
		color: var(--text);
		font-size: 0.66rem;
	}

	/* ---- features */
	.features,
	.how {
		max-width: 76rem;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.features h2,
	.how h2 {
		max-width: 36rem;
		margin: 0 0 2rem;
		font-family: var(--font-read);
		font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.4rem);
		font-weight: 560;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.features ul,
	.how ol {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.features li,
	.how li {
		padding: 1.4rem 1.4rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}
	.f-icon {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	h3 {
		margin: 0.9rem 0 0.4rem;
		font-size: 1rem;
		font-weight: 650;
	}
	.features p,
	.how p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.n {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent-strong);
		font-family: var(--font-read);
		font-weight: 650;
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		max-width: 76rem;
		margin: 2rem auto 0;
		padding: 2rem 1.5rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--text-faint);
		font-size: 0.82rem;
	}
	.foot p {
		margin: 0;
	}
	.foot a {
		color: var(--text-muted);
	}
	@media (max-width: 1000px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			padding-top: 2.5rem;
		}
		.window {
			transform: none;
		}
		.features ul,
		.how ol {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 640px) {
		.top nav a:not(.btn) {
			display: none;
		}
		.win-body {
			grid-template-columns: 1fr;
		}
		.win-side,
		.win-panel {
			display: none;
		}
	}
</style>
