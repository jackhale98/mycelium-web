---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	bodyClass?: string;
}

const {
	title,
	description = 'Read, link, capture and explore your org-roam notes from any device.',
	bodyClass,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f8f6f1" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111311" media="(prefers-color-scheme: dark)" />
		<meta name="referrer" content="no-referrer" />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<title>{title}</title>
		<script is:inline>
			// Apply the saved theme before first paint so there is no flash.
			try {
				const t = localStorage.getItem('mycelium:theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch {}
		</script>
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
