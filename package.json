{
  "name": "mycelium-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, accessible web app for reading, editing and exploring org-roam knowledge bases stored in git.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.0",
    "astro": "^7.4.1",
    "svelte": "^5.57.2",
    "unified": "^11.0.5",
    "uniorg": "^1.4.0",
    "uniorg-parse": "^3.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.20.5",
    "@types/unist": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
