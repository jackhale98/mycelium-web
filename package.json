{
	"name": "mycelium-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A fast, accessible web app for reading, editing and exploring org-roam knowledge bases stored in git.",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.mjs",
		"corpus": "node scripts/fetch-corpus.mjs"
	},
	"dependencies": {
		"@astrojs/svelte": "^9.1.0",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@isomorphic-git/lightning-fs": "^4.10.3",
		"@lezer/highlight": "^1.2.5",
		"astro": "^7.4.1",
		"buffer": "^6.0.3",
		"d3-drag": "^3.0.0",
		"d3-force": "^3.0.0",
		"d3-quadtree": "^3.0.1",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"dexie": "^4.4.6",
		"isomorphic-git": "^1.44.3",
		"katex": "^0.19.0",
		"minisearch": "^7.2.0",
		"node-diff3": "^3.2.1",
		"svelte": "^5.57.2",
		"unified": "^11.0.5",
		"uniorg": "^1.4.0",
		"uniorg-parse": "^3.2.2"
