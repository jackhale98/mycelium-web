	"devDependencies": {
		"@astrojs/check": "^0.9.11",
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@types/d3-drag": "^3.0.7",
		"@types/d3-force": "^3.0.10",
		"@types/d3-quadtree": "^3.0.6",
