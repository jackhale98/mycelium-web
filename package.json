		"@types/unist": "^3.0.3",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-license": "^3.7.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
